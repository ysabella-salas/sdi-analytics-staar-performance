{
  "name": "hisd-react",
  "version": "1.0.0",
  "private": true,
  "description": "HISD design-system components for React. Thin, typed wrappers over the token-driven CSS — pair with hisd-theme.css + components.css.",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly false --noEmit false"
  }
}
